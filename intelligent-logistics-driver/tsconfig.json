{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@il/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@il/shared/*": [
        "../packages/shared/src/*"
      ],
      "axios": [
        "./node_modules/axios"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
