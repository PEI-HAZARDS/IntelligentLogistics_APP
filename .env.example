# -----------------------------------------------------------
# Intelligent Logistics — Frontend Environment Variables
# Copy this file to .env and adjust values for the target installation.
#
# Build modes (passed via --mode flag to vite build/dev):
#   gate    — gate operator UI (default)
#   manager — logistics manager UI
# -----------------------------------------------------------

# --- nginx upstreams (injected into the container nginx templates via envsubst) ---
# Backend API Gateway host:port reached by the gate/manager nginx and the api-proxy.
API_UPSTREAM=IP:PORT
# MediaMTX WebRTC UDP media endpoint (host:port), proxied by the api-proxy stream{} block.
MEDIA_UPSTREAM=IP:PORT

# API Gateway base URL (FastAPI api_gateway service)
VITE_API_URL=http://IP:PORT/api

# WebSocket base URL (same host; use wss:// when TLS is configured)
VITE_WS_URL=ws://IP:PORT/api

# Grafana base URL for embedded panels (energy/RAN metrics)
# Points to the Grafana instance in the observability stack (separate from the app)
VITE_GRAFANA_URL=http://IP:PORT

# Use the in-app simulated energy graph instead of the live Grafana panel.
VITE_USE_SIMULATED_GRAPH=true

# --- Branding (optional — defaults shown) ---
VITE_PORT_NAME=Porto de Aveiro
VITE_SUBTITLE=Intelligent Logistics
VITE_LOGO_PATH=/logo.png
VITE_SUPPORT_EMAIL=support@email.com

# --- Expo app export ip ---
REACT_NATIVE_PACKAGER_HOSTNAME=IP

# --- Driver app (Expo) — absolute URLs pointing to the api-proxy ---
EXPO_PUBLIC_API_URL=http://IP:PORT/api
EXPO_PUBLIC_WS_URL=ws://IP:PORT/api

# Show the on-screen WebSocket debug panel in the driver app (true/false).
# Leave false for demos/production; set true while debugging realtime events.
EXPO_PUBLIC_DEBUG_MODE=false