user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

# Processed at container start by the official nginx entrypoint with
# NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx → this file becomes /etc/nginx/nginx.conf.
# ${API_UPSTREAM} and ${MEDIA_UPSTREAM} are injected from the environment.

# UDP stream proxy for WebRTC media (MediaMTX webrtcLocalUDPAddress :8189).
# Browser sends UDP to .108:8189 → nginx forwards to MediaMTX (${MEDIA_UPSTREAM}).
# Replies flow back via conntrack — nginx masquerades source so the browser
# sees responses originating from .108:8189 (matching the ICE candidate
# advertised in webrtcAdditionalHosts).
stream {
    upstream mediamtx_webrtc_udp {
        server ${MEDIA_UPSTREAM};
    }
    server {
        listen 8189 udp reuseport;
        proxy_pass mediamtx_webrtc_udp;
        proxy_timeout 180s;        # match conntrack UDP stream timeout
        proxy_responses 0;          # WebRTC media is bidirectional, no fixed count
        error_log /var/log/nginx/stream-error.log warn;
    }
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default "";
        "websocket" "upgrade";
    }

    # Front-door HTTP proxy on .108:8000 — primarily for the driver app, which
    # cannot use the SPA's same-origin /api/ proxy. Operator/manager UIs hit
    # /api/ through their own nginx (gate-ui / manager-ui container) instead.
    server {
        listen 80 default_server;
        server_name _;

        # Liveness probe for the container healthcheck.
        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        location /api/ {
            proxy_pass http://${API_UPSTREAM};
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket upgrade for /api/ws/... and WHEP long-lived requests.
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
